from flask import Flask, request, render_template_string

app = Flask(__name__)

HTML = '''
<!DOCTYPE html>
<html>
<head>
<title>AI HR Recruitment Assistant</title>

<style>

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
}

.header {
    background: #4f46e5;
    color: white;
    padding: 25px;
}

.header h1 {
    margin: 0;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: 30px auto;
}

.box {
    background: white;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 15px;
    box-shadow: 0 4px 12px #cccccc;
}

h2 {
    color: #3730a3;
}

label {
    display: block;
    font-weight: bold;
    margin-top: 15px;
}

input, textarea {
    width: 100%;
    padding: 12px;
    margin-top: 7px;
    border: 1px solid #cccccc;
    border-radius: 8px;
    box-sizing: border-box;
}

textarea {
    height: 120px;
}

button {
    width: 100%;
    padding: 14px;
    margin-top: 20px;
    background: #4f46e5;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

.result {
    background: #eef2ff;
    padding: 20px;
    border-radius: 10px;
}

.score {
    font-size: 45px;
    font-weight: bold;
    color: #4f46e5;
}

.skill {
    display: inline-block;
    background: #dbeafe;
    color: #1e40af;
    padding: 8px 12px;
    margin: 4px;
    border-radius: 20px;
}

.success {
    background: #dcfce7;
    color: #15803d;
    padding: 15px;
    border-radius: 10px;
    font-size: 20px;
    font-weight: bold;
}

.warning {
    background: #fef3c7;
    color: #b45309;
    padding: 15px;
    border-radius: 10px;
    font-size: 20px;
    font-weight: bold;
}

.danger {
    background: #fee2e2;
    color: #b91c1c;
    padding: 15px;
    border-radius: 10px;
    font-size: 20px;
    font-weight: bold;
}

</style>
</head>

<body>

<div class="header">
    <h1>AI HR Recruitment Assistant</h1>
    <p>Smart Resume Screening and Candidate Matching System</p>
</div>

<div class="container">

<div class="box">

<h2>Candidate Screening</h2>

<form method="POST">

<label>Job Position</label>
<input type="text" name="job"
placeholder="Example: Python Developer" required>

<label>Required Skills</label>
<input type="text" name="required"
placeholder="Python, SQL, Machine Learning, Git" required>

<label>Candidate Name</label>
<input type="text" name="name"
placeholder="Enter candidate name" required>

<label>Resume / Candidate Skills</label>
<textarea name="resume"
placeholder="Enter resume skills here..."
required></textarea>

<button type="submit">
Analyze Candidate
</button>

</form>

</div>


{% if result %}

<div class="box">

<h2>AI Recruitment Result</h2>

<div class="result">

<h3>Candidate: {{ name }}</h3>

<p><b>Position:</b> {{ job }}</p>

<p>AI Skill Match Score</p>

<div class="score">
{{ score }}%
</div>

<h3>Matched Skills</h3>

{% for skill in matched %}
<span class="skill">{{ skill }}</span>
{% endfor %}

{% if not matched %}
<p>No matching skills.</p>
{% endif %}


<h3>Missing Skills</h3>

{% for skill in missing %}
<span class="skill">{{ skill }}</span>
{% endfor %}

{% if not missing %}
<p>All required skills are available.</p>
{% endif %}


<h3>AI Recommendation</h3>

{% if recommendation == "SHORTLIST" %}

<div class="success">
SHORTLIST - Candidate is highly suitable
</div>

{% elif recommendation == "REVIEW" %}

<div class="warning">
REVIEW - Candidate needs further evaluation
</div>

{% else %}

<div class="danger">
REJECT - Candidate does not meet requirements
</div>

{% endif %}

</div>

</div>

{% endif %}


<div class="box">

<h2>AI Interview Questions</h2>

<ol>
<li>Tell me about yourself.</li>
<li>Why are you interested in this position?</li>
<li>Describe your most important project.</li>
<li>What technical skills do you have?</li>
<li>How do you handle deadlines?</li>
<li>How do you solve technical problems?</li>
<li>Where do you see yourself in five years?</li>
</ol>

</div>

</div>

</body>
</html>
'''


@app.route("/", methods=["GET", "POST"])
def home():

    result = False

    name = ""
    job = ""
    score = 0

    matched = []
    missing = []

    recommendation = ""

    if request.method == "POST":

        job = request.form.get("job", "")
        name = request.form.get("name", "")

        required = request.form.get("required", "")
        resume = request.form.get("resume", "")

        required_skills = []

        for skill in required.split(","):
            skill = skill.strip().lower()

            if skill != "":
                required_skills.append(skill)

        resume_text = resume.lower()

        for skill in required_skills:

            if skill in resume_text:
                matched.append(skill)

            else:
                missing.append(skill)

        if len(required_skills) > 0:

            score = round(
                len(matched) / len(required_skills) * 100,
                2
            )

        if score >= 80:
            recommendation = "SHORTLIST"

        elif score >= 50:
            recommendation = "REVIEW"

        else:
            recommendation = "REJECT"

        result = True

    return render_template_string(
        HTML,
        result=result,
        name=name,
        job=job,
        score=score,
        matched=matched,
        missing=missing,
        recommendation=recommendation
    )


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
